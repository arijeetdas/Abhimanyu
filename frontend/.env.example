# Copy to frontend/.env.local (the dev script creates it for you). Never commit .env.local.
# EXPO_PUBLIC_* values are bundled into the website and the app: never put secrets here.

# Backend URL. Leave empty to auto-detect (localhost on web, your PC's Wi-Fi IP on a phone).
EXPO_PUBLIC_API_URL=

# Firebase web app config (Firebase console > Project settings > General > Your apps > Web app > Config).
# Leave empty to run in demo mode (accounts stored only on this device).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Store onboarding profiles in Cloud Firestore (users/{uid}). Set to false to keep them on the device only.
EXPO_PUBLIC_FIREBASE_USE_FIRESTORE=true

# Force demo mode even when Firebase is configured (e.g. offline demos): demo
EXPO_PUBLIC_AUTH_MODE=
