# Copy to backend/.env (the setup script does this for you). Never commit .env.
# Variable names follow docs/Tech_Stack.md section 14.

# Backend
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# PostgreSQL / Supabase
DATABASE_URL=

# Graph database
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# Vector database
CHROMA_HOST=
CHROMA_PORT=

# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Background processing
REDIS_URL=

# Notifications
FIREBASE_CREDENTIALS_PATH=
